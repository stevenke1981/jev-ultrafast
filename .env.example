# OpenRouter chooses an operation and a target, and writes field text when the operation is TYPE_TEXT.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inception/mercury-2.5

# Optional OpenRouter settings.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REASONING=none
# OPENROUTER_MAX_TOKENS=2048
# OPENROUTER_SCHEMA=1
# OPENROUTER_SITE_URL=https://example.com
# OPENROUTER_APP_NAME=Jev Ultrafast

# Force a provider instead of inferring it from the keys you set: openrouter | typesafe.
# JEVA_PROVIDER=openrouter

# Legacy TypeSafe choice provider. Optional; used only with JEVA_PROVIDER=typesafe
# or when OPENROUTER_API_KEY is unset.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Text helper for TYPE_TEXT. Credentials stay server-side. Defaults to the OpenRouter key above,
# the OpenRouter endpoint, and the model below.
# TEXT_MODEL_API_KEY=
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
